{
  "name": "nexalab-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "pretest": "node scripts/assert-isolated-db.mjs tests",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "predb:migrate": "node scripts/assert-isolated-db.mjs schema migration",
    "db:migrate": "prisma migrate deploy",
    "predb:seed": "node scripts/assert-isolated-db.mjs database seed",
    "db:seed": "tsx prisma/seed.ts",
    "predb:seed:fl03-isolated": "node scripts/assert-isolated-db.mjs database seed",
    "db:seed:fl03-isolated": "tsx scripts/seed-fl03-density-isolated.ts",
    "ingest:khtn8:dry-run": "tsx tools/nexalab-ingest/import_chapter_seed.ts --dry-run",
    "ingest:khtn8:fixture-check": "tsx tools/nexalab-ingest/import_chapter_seed.ts --validate-only --input=tools/nexalab-ingest/fixtures/sgk-khtn8-chapter-01.seed.fixture.json",
    "preingest:khtn8:seed": "node scripts/assert-isolated-db.mjs ingest seed",
    "ingest:khtn8:seed": "tsx tools/nexalab-ingest/import_chapter_seed.ts --apply",
    "ingest:khtn8:ui-test-dry-run": "tsx tools/nexalab-ingest/seed_chapter_ui_test.ts --dry-run",
    "ingest:khtn8:ui-test-seed": "tsx tools/nexalab-ingest/seed_chapter_ui_test.ts --apply",
    "lint": "tsc --noEmit",
    "check:layers": "tsx scripts/check-layers.ts",
    "pretest:integration": "node scripts/assert-isolated-db.mjs integration tests",
    "test:integration": "tsx scripts/integration.mjs",
    "pretest:a5:db-interruption": "node scripts/assert-isolated-db.mjs database interruption test",
    "test:a5:db-interruption": "node scripts/a5-database-interruption.mjs",
    "b2:preflight": "node scripts/b2-preflight.mjs",
    "preb2:backfill": "node scripts/assert-isolated-db.mjs backfill",
    "b2:backfill": "node scripts/b2-preflight.mjs --apply",
    "pretest:b2": "node scripts/assert-isolated-db.mjs integration tests",
    "test:b2": "node scripts/b2-integration.mjs",
    "progress:check": "tsx scripts/progress-projection.ts",
    "preprogress:rebuild": "node scripts/assert-isolated-db.mjs progress rebuild",
    "progress:rebuild": "tsx scripts/progress-projection.ts --apply",
    "b1:preflight": "tsx scripts/b1-preflight.ts",
    "pretest:b1": "node scripts/assert-isolated-db.mjs integration tests",
    "test:b1": "tsx scripts/b1-integration.mjs",
    "pretest:b0": "node scripts/assert-isolated-db.mjs integration tests",
    "test:b0": "tsx scripts/b0-integration.mjs",
    "pretest:c2": "node scripts/assert-isolated-db.mjs integration tests",
    "test:c2": "tsx scripts/c2-integration.mjs",
    "pretest:cf": "node scripts/assert-isolated-db.mjs integration tests",
    "test:cf": "tsx scripts/cf-integration.mjs",
    "pretest:i3": "node scripts/assert-isolated-db.mjs integration tests",
    "test:i3": "tsx scripts/i3-integration.mjs",
    "pretest:acc": "node scripts/assert-isolated-db.mjs integration tests",
    "test:acc": "tsx scripts/acc-integration.mjs",
    "pretest:learning": "node scripts/assert-isolated-db.mjs integration tests",
    "test:learning": "tsx scripts/learning-integration.mjs",
    "pretest:classes": "node scripts/assert-isolated-db.mjs integration tests",
    "test:classes": "tsx scripts/classes-integration.mjs",
    "c2:preflight": "node scripts/c2-preflight.mjs",
    "r2:check": "tsx scripts/r2-check.ts",
    "precf:migrate-assets": "node scripts/assert-isolated-db.mjs asset migration",
    "cf:migrate-assets": "tsx scripts/cf-migrate-assets.ts",
    "precontent:release": "node scripts/assert-isolated-db.mjs content release",
    "content:release": "tsx scripts/content-release.ts",
    "content:studio:validate": "tsx scripts/content-studio-validate.ts",
    "mailbox": "node scripts/mailbox.mjs",
    "format": "prettier --write src packages prisma scripts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/smtp-server": "^3.5.13",
    "prettier": "^3.9.8",
    "prisma": "^6.19.0",
    "smtp-server": "^3.19.13",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "multer": "^2.3.0",
    "deepmerge-ts": "^8.0.0"
  }
}
