{
  "name": "nexalab-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "tsc --noEmit",
    "test:integration": "node scripts/integration.mjs",
    "test:a5:db-interruption": "node scripts/a5-database-interruption.mjs",
    "progress:check": "tsx scripts/progress-projection.ts",
    "progress:rebuild": "tsx scripts/progress-projection.ts --apply",
    "b1:preflight": "tsx scripts/b1-preflight.ts",
    "test:b1": "node scripts/b1-integration.mjs",
    "format": "prettier --write src packages prisma scripts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/smtp-server": "^3.5.13",
    "prettier": "^3.9.8",
    "prisma": "^6.19.0",
    "smtp-server": "^3.19.13",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "multer": "^2.3.0",
    "deepmerge-ts": "^8.0.0"
  }
}
