              "nasa-buoyancy"
            ]
          },
          {
            "id": "apparent-weight",
            "text": "Với vật treo đứng yên và dây căng, số chỉ lực kế giảm một lượng bằng lực đẩy của chất lỏng.",
            "important": true,
            "sourceIds": [
              "openstax-buoyancy",
              "nasa-buoyancy"
            ]
          }
        ],
        "terms": [
          "Lực đẩy",
