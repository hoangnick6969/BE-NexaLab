generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

enum LessonStepType {
  READING
  VIDEO
  STUDY_CARDS
  QUIZ
  LAB
  CHALLENGE
  BASIC_EXERCISE
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  pending
  approved
  removed
}

enum ClassResourceKind {
  DECK
  STUDY_QUIZ
  TEST
  LAB
  DOCUMENT
  REPORT_TEMPLATE
  LINK
  /// TAI-02 written task with a versioned rubric (graded by the teacher).
  WRITTEN_TASK
  /// P0 C3: Class Explore, a teacher's choice inside a Foundational Explore Lab template (no LabRun, no verdict).
  EXPLORE_LAB
}

enum ClassResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StepProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ParentLinkStatus {
  pending
  approved
  revoked
}

enum EbookAnnotationKind {
  HIGHLIGHT
  UNDERLINE
  NOTE
}

model User {
  id                          String                       @id @default(cuid())
  username                    String?                      @unique
  email                       String?                      @unique
  passwordHash                String
  fullName                    String
  role                        Role
  /// SAI-03A lesson question hints (attempt- and run-less HintLog rows).
  lessonHints                 HintLog[]                    @relation("lessonHintStudent")
  /// SAI-04 tutor conversations (dev/test only until SG-2 / SG-4).
  tutorConversations          TutorConversation[]
  tutorMessages               TutorMessage[]
  grade                       Int                          @default(8)
  studentLevel                String                       @default("beginner")
  status                      String                       @default("active")
  mustChangePassword          Boolean                      @default(false)
  temporaryPasswordExpiresAt  DateTime?
  consentAt                   DateTime?
  emailVerifiedAt             DateTime?
  linkCode                    String?                      @unique
  /// Set when an admin disables the account (C2-T1); cleared on reactivation.
  disabledAt                  DateTime?
  /// Private avatar object key in object storage (D-ACC-03); read only through short presigned URLs.
  avatarKey                   String?
  avatarUpdatedAt             DateTime?
  /// UI preferences (acc-4, acc-5): { theme?: "system" | "light" | "dark", locale?: "vi" | "en" }; read through users/preferences.ts.
  preferences                 Json                         @default("{}")
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  sessions                    Session[]
  attempts                    Attempt[]
  enrollments                 Enrollment[]
  classes                     Classroom[]
  lessons                     Lesson[]
  progress                    Progress[]
  stepProgress                StepProgress[]
  quizAttempts                QuizAttempt[]
  basicExerciseAttempts       BasicExerciseAttempt[]
  saved                       SavedExperiment[]
  parents                     ParentLink[]                 @relation("student")
  children                    ParentLink[]                 @relation("parent")
  assignmentTargets           AssignmentTarget[]
  assignmentSubmissions       AssignmentSubmission[]
  exploreSubmissions          ClassExploreSubmission[]
  classLabAdditionalResponses ClassLabAdditionalResponse[]
  notifications               Notification[]
  ebookAnnotations            EbookAnnotation[]
  labReviewAssignments        LabReviewerAuthorization[]   @relation("LabReviewerAuthorizationUser")
  labReleaseReviews           LabReleaseReview[]           @relation("LabReleaseReviewer")
  /// TAI-04 (TAI4-T3): acknowledgements that concern this student as the subject (cascade on user deletion).
  insightAcknowledgements     InsightAcknowledgement[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  kind      String   @default("refresh")
  /// D-ACC-01: persistent 30-day session (true) or browser-session cookie with a 12-hour server expiry (false).
  /// Existing rows predate the choice and were 7-day persistent sessions.
  remember  Boolean  @default(true)
  expiresAt DateTime

  @@index([userId])
}

model ParentLink {
  parentId   String
  studentId  String
  parent     User             @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  student    User             @relation("student", fields: [studentId], references: [id], onDelete: Cascade)
  verifiedAt DateTime         @default(now())
  status     ParentLinkStatus @default(pending)
  revokedAt  DateTime?
  codeId     String?

  @@id([parentId, studentId])
  @@index([parentId, status])
  @@index([studentId, status])
}

model ParentLinkCode {
  id                 String    @id @default(cuid())
  studentId          String
  teacherId          String
  classId            String
  codeHash           String    @unique
  keyVersion         Int       @default(1)
  guardianVerifiedAt DateTime
  expiresAt          DateTime
  consumedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([studentId, expiresAt])
  @@index([teacherId, classId, createdAt])
}

model ParentConsent {
  id          String    @id @default(cuid())
  userId      String
  purpose     String
  version     String
  contentHash String
  actorId     String?
  acceptedAt  DateTime  @default(now())
  withdrawnAt DateTime?

  @@index([userId, purpose, version])
}

model Classroom {
  id                      String                   @id @default(cuid())
  teacherId               String
  teacher                 User                     @relation(fields: [teacherId], references: [id])
  name                    String
  grade                   Int                      @default(8)
  status                  ClassroomStatus          @default(ACTIVE)
  archivedAt              DateTime?
  joinCodeEnabled         Boolean                  @default(true)
  requiresApproval        Boolean                  @default(false)
  /// Opaque 6-character Crockford Base32 locator; the secret is stored only as an HMAC.
  joinLocator             String?                  @unique
  joinSecretHash          String?
  joinKeyVersion          Int?
  joinCodeRotatedAt       DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt
  enrollments             Enrollment[]
  assignments             Assignment[]
  resources               ClassResource[]
  /// TAI-04 (TAI4-T3): teacher responses to insights of this class (cascade on class deletion).
  insightAcknowledgements InsightAcknowledgement[]

  @@index([teacherId, status])
}

/// Immutable class-owned authoring unit. Published records are never edited in place.
model ClassResource {
  id                  String                       @id @default(cuid())
  classId             String
  classroom           Classroom                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  kind                ClassResourceKind
  title               String
  lessonId            String?
  lesson              Lesson?                      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  version             Int                          @default(1)
  status              ClassResourceStatus          @default(DRAFT)
  content             Json
  createdById         String
  createdAt           DateTime                     @default(now())
  publishedAt         DateTime?
  archivedAt          DateTime?
  practice            ClassResourcePractice[]
  labRuns             LabRun[]
  additionalResponses ClassLabAdditionalResponse[]

  @@unique([classId, kind, title, version])
  @@index([classId, status, kind, createdAt])
  @@index([lessonId])
}

/// Latest unscored practice state; deliberately contains no grade or verdict fields.
model ClassResourcePractice {
  id         String        @id @default(cuid())
  resourceId String
  resource   ClassResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  studentId  String
  state      Json
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([resourceId, studentId])
  @@index([studentId, updatedAt])
}

/// Class Explore submission (P0 C3.4): what the student measured and explained. Never a verdict, score or progress.
model ClassExploreSubmission {
  id             String     @id @default(cuid())
  assignmentId   String
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  idempotencyKey String?
  /// { measures: [{ itemId, tenthsPh }], explanation }, checked against the assignment snapshot's requirements.
  answers        Json
  /// SUBMITTED, then REVIEWED once the teacher has commented.
  status         String     @default("SUBMITTED")
  submittedAt    DateTime   @default(now())
  feedback       String?
  reviewedById   String?
  reviewedAt     DateTime?

  /// One submission per student and assignment: a retry returns the saved one.
  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])
  @@index([assignmentId, status])
}

/// Immutable student text response attempts for teacher-authored Class Lab prompts.
model ClassLabAdditionalResponse {
  id              String        @id @default(cuid())
  resourceId      String
  resource        ClassResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  assignmentId    String?
  assignment      Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  studentId       String
  student         User          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  resourceVersion Int
  promptSnapshot  Json
  answers         Json
  attempt         Int
  idempotencyKey  String?
  score           Int?
  feedback        String?
  gradedById      String?
  gradedAt        DateTime?
  submittedAt     DateTime      @default(now())

  @@index([studentId, idempotencyKey])
  @@index([resourceId, assignmentId, studentId, attempt])
  @@index([resourceId, assignmentId, submittedAt])
  @@index([studentId, submittedAt])
}

model Enrollment {
  classId         String
  studentId       String
  classroom       Classroom        @relation(fields: [classId], references: [id], onDelete: Cascade)
  student         User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status          EnrollmentStatus @default(pending)
  /// Deprecated mirror of `status = approved`, kept in sync until the contract migration.
  approved        Boolean          @default(false)
  joinedAt        DateTime         @default(now())
  statusChangedAt DateTime         @default(now())

  @@id([classId, studentId])
  @@index([studentId, status])
}

model Subject {
  id                         String                       @id
  name                       String
  /// Optional external ebook/reference URL; linking does not grant reproduction rights.
  ebookUrl                   String?
  lessons                    Lesson[]
  labs                       Lab[]
  ebookAnnotations           EbookAnnotation[]
  ebookEditions              EbookEdition[]
  foundationalCourseVersions FoundationalCourseVersion[]
  curriculumFrameworks       CurriculumFrameworkSubject[]
}

/// Versioned authoritative curriculum framework metadata, independent of source textbooks.
model CurriculumFramework {
  id             String                       @id
  /// Stable NexaLab framework identity shared by its immutable versions.
  frameworkKey   String
  title          String
  version        String
  /// Official source authority, URL, publication/access dates and source checksum.
  sourceMetadata Json
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @default(now()) @updatedAt
  subjects       CurriculumFrameworkSubject[]

  @@unique([frameworkKey, version])
  @@index([title, version])
}

/// Framework coverage of a subject at a grade; chapters/topics/outcomes remain in the existing taxonomy.
model CurriculumFrameworkSubject {
  frameworkId String
  framework   CurriculumFramework @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  subjectId   String
  subject     Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  grade       Int
  createdAt   DateTime            @default(now())

  @@id([frameworkId, subjectId, grade])
  @@index([subjectId, grade])
}

model EbookAnnotation {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId           String
  subject             Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  documentFingerprint String
  pageNumber          Int
  kind                EbookAnnotationKind
  startOffset         Int
  endOffset           Int
  selectedText        String              @db.Text
  prefix              String?             @db.Text
  suffix              String?             @db.Text
  noteText            String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId, subjectId, documentFingerprint, createdAt], map: "ebook_annotation_owner_version_idx")
  @@index([subjectId])
}

model Lesson {
  id                        String                     @id @default(cuid())
  subjectId                 String
  subject                   Subject                    @relation(fields: [subjectId], references: [id])
  authorId                  String
  author                    User                       @relation(fields: [authorId], references: [id])
  title                     String
  chapter                   String
  grade                     Int
  topic                     String
  learningObjective         String
  prerequisites             String
  curriculum                String
  content                   String
  labId                     String?
  status                    String                     @default("draft")
  materials                 Json                       @default("[]")
  questions                 Json                       @default("[]")
  /// TEACHER_PRIVATE (owner-only edit, self-review) or SHARED_LIBRARY (admin-managed baseline).
  scope                     String                     @default("TEACHER_PRIVATE")
  /// Synthetic development/E2E fixture; never presented as released corpus.
  synthetic                 Boolean                    @default(false)
  clonedFromId              String?
  /// Allowlisted self-review attestation required to publish teacher-private content.
  review                    Json?
  /// KHTN content strand (MATTER | ENERGY | LIVING | EARTH_SKY).
  domain                    String?
  /// CurriculumOutcome codes this lesson addresses.
  outcomeCodes              Json                       @default("[]")
  /// Teacher-chosen challenge parameters, validated against the model's allowed ranges.
  challengeParams           Json?
  /// Named shared-library release reviews: { kind: { reviewerId, at, note? } }.
  releaseReview             Json?
  /// Released content-pack version this shared lesson materializes (CF-T1); null for authored lessons.
  packVersionId             String?
  packVersion               ContentPackVersion?        @relation(fields: [packVersionId], references: [id], onDelete: Restrict)
  classResources            ClassResource[]
  curriculumChapterCode     String?
  curriculumChapter         CurriculumChapter?         @relation(fields: [curriculumChapterCode], references: [code], onDelete: Restrict)
  curriculumTopicCode       String?
  curriculumTopic           CurriculumTopic?           @relation(fields: [curriculumTopicCode], references: [code], onDelete: Restrict)
  curriculumOrder           Int?
  /// Admin quarantine (C2-T2): status becomes "quarantined"; the prior status is restored on release.
  quarantinedAt             DateTime?
  quarantineReason          String?
  statusBeforeQuarantine    String?
  publishedAt               DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now()) @updatedAt
  steps                     LessonStep[]
  ebookLocators             LessonEbookLocator[]
  foundationalCourseLessons FoundationalCourseLesson[]

  @@index([scope, status, grade])
  @@index([authorId, status])
  @@index([subjectId])
  @@index([packVersionId])
  @@index([curriculumTopicCode])
  @@index([curriculumChapterCode, curriculumOrder])
}

/// Grade 8–9 KHTN outcome map (Content Foundation). `synthetic` rows are dev fixtures and never count as released coverage.
model CurriculumOutcome {
  code           String   @id
  grade          Int
  domain         String
  chapter        String
  statement      String
  /// Append-only source digests, locators, origin types and human review references for each import.
  sourceEvidence Json?
  synthetic      Boolean  @default(false)
  /// active | archived. Archived outcomes stay traceable but cannot be newly mapped.
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([grade, domain])
}

/// Curriculum chapter (C2-T2). `code` is an immutable identifier; a duplicate conflicts instead of overwriting.
model CurriculumChapter {
  code          String            @id
  subjectId     String
  grade         Int
  domain        String
  title         String
  /// active | archived
  status        String            @default("active")
  synthetic     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  topics        CurriculumTopic[]
  lessons       Lesson[]
  officialOrder Int               @default(0)

  @@index([grade, domain])
}

/// Topic inside a chapter, mapped to the outcomes it teaches.
model CurriculumTopic {
  code          String            @id
  chapterCode   String
  chapter       CurriculumChapter @relation(fields: [chapterCode], references: [code])
  lessons       Lesson[]
  officialOrder Int               @default(0)
  title         String
  outcomeCodes  Json              @default("[]")
  /// active | archived
  status        String            @default("active")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  @@index([chapterCode])
}

model LessonStep {
  id                    String                 @id @default(cuid())
  lessonId              String
  lesson                Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type                  LessonStepType
  position              Int
  required              Boolean                @default(true)
  config                Json
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  progress              StepProgress[]
  basicExerciseAttempts BasicExerciseAttempt[]
  hints                 HintLog[]

  @@unique([lessonId, position])
  @@index([lessonId, type])
}

model StepProgress {
  id             String             @id @default(cuid())
  studentId      String
  student        User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stepId         String
  step           LessonStep         @relation(fields: [stepId], references: [id], onDelete: Cascade)
  /// Null is retained only for legacy/free-practice evidence. Assigned writes must set this.
  assignmentId   String?
  assignment     Assignment?        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  status         StepProgressStatus @default(NOT_STARTED)
  progressValue  Int                @default(0)
  lastPosition   Int?
  visitedCardIds Json               @default("[]")
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime           @updatedAt

  @@unique([studentId, assignmentId, stepId])
  @@index([studentId, stepId])
  @@index([assignmentId, studentId])
  @@index([stepId])
}

model QuizAttempt {
  id               String   @id @default(cuid())
  studentId        String
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId         String
  stepId           String
  assignmentId     String?
  answers          Json
  questionSnapshot Json
  correctCount     Int
  questionCount    Int
  score            Float
  passed           Boolean
  idempotencyKey   String
  createdAt        DateTime @default(now())

  @@unique([studentId, idempotencyKey])
  @@index([studentId, lessonId, createdAt])
  @@index([lessonId, stepId, passed])
  @@index([studentId, createdAt, id])
}

model BasicExerciseAttempt {
  id             String     @id @default(cuid())
  studentId      String
  student        User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId       String
  stepId         String
  step           LessonStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  answers        Json
  score          Int
  passThreshold  Int
  passed         Boolean
  idempotencyKey String
  createdAt      DateTime   @default(now())

  @@unique([studentId, idempotencyKey])
  @@index([studentId, lessonId, stepId, createdAt])
  @@index([lessonId, stepId, passed])
  @@index([stepId])
}

model Lab {
  id                 String       @id
  subjectId          String
  subject            Subject      @relation(fields: [subjectId], references: [id])
  title              String
  grade              Int          @default(8)
  topic              String
  learningObjective  String
  status             String       @default("published")
  /// Public discovery is opt-in after foundational release review.
  scope              String       @default("CLASS_PRIVATE")
  releaseCleared     Boolean      @default(false)
  topicCode          String?
  synthetic          Boolean      @default(false)
  simulationModelRef String
  config             Json         @default("{}")
  assets             Json         @default("[]")
  challenges         Challenge[]
  releases           LabRelease[]

  @@index([subjectId])
}

/// Immutable public-release candidate; approval receipts bind to `digest` of the full snapshot.
model LabRelease {
  id            String             @id @default(cuid())
  labId         String
  lab           Lab                @relation(fields: [labId], references: [id], onDelete: Restrict)
  version       Int
  digest        String
  snapshot      Json
  /// DRAFT | APPROVED | ACTIVE | SUPERSEDED | QUARANTINED
  status        String             @default("DRAFT")
  reason        String
  createdById   String
  createdAt     DateTime           @default(now())
  activatedAt   DateTime?
  quarantinedAt DateTime?
  reviews       LabReleaseReview[]

  @@unique([labId, version])
  @@unique([labId, digest])
  @@index([labId, status])
}

/// An administrator delegates a specific review duty to an authenticated staff account.
model LabReviewerAuthorization {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("LabReviewerAuthorizationUser", fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String
  kind           String
  authorizedById String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([userId, subjectId, kind])
  @@index([subjectId, kind, active])
}

/// Append-only human decision by the authorized account, on the exact release digest.
model LabReleaseReview {
  id            String     @id @default(cuid())
  releaseId     String
  release       LabRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  reviewerId    String
  reviewer      User       @relation("LabReleaseReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  kind          String
  decision      String
  releaseDigest String
  note          String
  /// Structured evidence for owner signoff and developer approval receipts.
  evidence      Json?
  createdAt     DateTime   @default(now())

  @@unique([releaseId, kind])
  @@index([reviewerId, createdAt])
}

model FoundationalCourseVersion {
  id            String                     @id
  subjectId     String
  subject       Subject                    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  grade         Int
  version       String
  status        String                     @default("draft")
  sourceVersion String
  lessons       FoundationalCourseLesson[]
  createdAt     DateTime                   @default(now())

  @@unique([subjectId, grade, version])
  @@index([grade, status])
}

model FoundationalCourseLesson {
  courseVersionId   String
  courseVersion     FoundationalCourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  lessonId          String
  lesson            Lesson                    @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  officialOrder     Int
  foundationalLabId String?

  @@id([courseVersionId, lessonId])
  @@unique([courseVersionId, officialOrder])
  @@index([lessonId])
}

model EbookEdition {
  id                   String               @id
  subjectId            String
  subject              Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  url                  String
  version              String
  fallbackPhysicalPage Int                  @default(1)
  isCurrent            Boolean              @default(false)
  coverAssetVersionId  String?
  coverAssetVersion    AssetVersion?        @relation(fields: [coverAssetVersionId], references: [id], onDelete: Restrict)
  locators             LessonEbookLocator[]
  createdAt            DateTime             @default(now())

  @@unique([subjectId, version])
  @@index([coverAssetVersionId])
}

model LessonEbookLocator {
  id                 String       @id @default(cuid())
  lessonId           String
  lesson             Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  editionId          String
  edition            EbookEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  printedPageLabel   String?
  physicalPageIndex  Int
  verificationStatus String       @default("unverified")
  provenance         String
  sourceMapVersion   String
  updatedAt          DateTime     @updatedAt

  @@unique([lessonId, editionId])
  @@index([editionId, verificationStatus])
}

model Challenge {
  id          String    @id
  labId       String
  lab         Lab       @relation(fields: [labId], references: [id])
  objective   String
  constraints Json
  difficulty  String    @default("intermediate")
  attempts    Attempt[]

  @@index([labId])
}

model Assignment {
  id                          String                       @id @default(cuid())
  classId                     String
  classroom                   Classroom                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  contentId                   String
  contentType                 String
  title                       String
  dueDate                     DateTime?
  /// Deprecated mirror of the target snapshot; AssignmentTarget is authoritative.
  studentIds                  Json                         @default("[]")
  /// CLASS (approved members at creation) or SUBSET (selected approved members).
  audience                    String                       @default("CLASS")
  /// sha256 of the sorted target student IDs, used by the active-duplicate rule.
  targetHash                  String?
  /// Immutable content version at assignment time (lesson structure or lab model/config hash).
  contentVersion              String?
  /// Null for legacy assignments; never backfilled from current active versions.
  labExecution                Json?
  labExecutionDigest          String?
  classLabSnapshot            Json?
  /// Class Explore (P0 C3.4): the pinned effective bench, requirements and question this assignment was given with.
  exploreSnapshot             Json?
  status                      String                       @default("ACTIVE")
  createdById                 String?
  archivedAt                  DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  targets                     AssignmentTarget[]
  deadlineRevisions           AssignmentDeadlineRevision[]
  submissions                 AssignmentSubmission[]
  /// TAI-03 (TAI3-T4): immutable similarity runs over this assignment's current submissions.
  similarityRuns              SubmissionSimilarityRun[]
  stepProgress                StepProgress[]
  classLabAdditionalResponses ClassLabAdditionalResponse[]
  exploreSubmissions          ClassExploreSubmission[]
  insightDisagreements        HintInsightDisagreement[]

  @@index([classId, status, dueDate])
  @@index([contentType, contentId, status])
}

model AssignmentTarget {
  assignmentId String
  studentId    String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([assignmentId, studentId])
  @@index([studentId])
}

/// Immutable due-date history of a scored test assignment (I3). Revision 1 is written at creation;
/// Assignment.dueDate mirrors the latest revision.
model AssignmentDeadlineRevision {
  id                      String                 @id @default(cuid())
  assignmentId            String
  assignment              Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  revision                Int
  dueAt                   DateTime
  actorId                 String
  note                    String?
  /// Late submission whose review triggered this revision; null for revision 1.
  triggeredBySubmissionId String?
  createdAt               DateTime               @default(now())
  submissions             AssignmentSubmission[]
  lateDecisions           LateDecision[]

  @@unique([assignmentId, revision])
}

/// TAI-02: how an AssignmentSubmission is scored.
enum GradingMode {
  AUTO
  TEACHER
}

/// Immutable test submission (I3 / 3.2). The server scores every submission; a late one stays
/// pending until a LateDecision exists. The latest submission per student is current.
model AssignmentSubmission {
  id                 String                      @id @default(cuid())
  assignmentId       String
  assignment         Assignment                  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          String
  student            User                        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// Deadline revision in force when the server received the submission.
  deadlineRevisionId String
  deadlineRevision   AssignmentDeadlineRevision  @relation(fields: [deadlineRevisionId], references: [id])
  /// Resource version answered, so later test revisions never rescore history.
  resourceVersion    Int
  answers            Json
  /// Non-null when gradingMode = AUTO (DB CHECK AssignmentSubmission_auto_score_check); null for TEACHER (TAI-02 written).
  score              Int?
  correctCount       Int?
  questionCount      Int
  /// AUTO = server-scored TEST; TEACHER = WRITTEN_TASK graded by the owning teacher (TAI-02).
  gradingMode        GradingMode                 @default(AUTO)
  /// ON_TIME (submittedAt <= dueAt) or LATE.
  timing             String
  lateReason         String?
  submittedAt        DateTime                    @default(now())
  decision           LateDecision?
  /// TAI-02 (TAI2-T3): append-only teacher grades; the latest row is the current grade.
  gradeDecisions     WrittenGradeDecision[]
  /// TAI-03 (TAI3-T4): matches that name this submission on either side (cascade on delete).
  similarityMatchesA SubmissionSimilarityMatch[] @relation("SimilarityMatchA")
  similarityMatchesB SubmissionSimilarityMatch[] @relation("SimilarityMatchB")
  /// TAI-02 (TAI2-T4): ASSESS_SUBMISSION jobs and their suggestions die with the submission (redacted snapshot included).
  aiJobs             AiJob[]
  aiSuggestions      AiAssessmentSuggestion[]

  @@index([assignmentId, studentId, submittedAt])
  @@index([studentId, submittedAt])
  @@index([deadlineRevisionId])
}

/// TAI-02 (TAI2-T3): how a written submission was graded.
enum WrittenGradeKind {
  MANUAL
  ACCEPTED_AI
  EDITED_AI
  REJECTED_AI
}

/// TAI-02 (TAI2-T3): append-only teacher grade for one written submission. Only MANUAL is written in T3.
model WrittenGradeDecision {
  id                  String               @id @default(cuid())
  submissionId        String
  submission          AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actorId             String
  kind                WrittenGradeKind
  basedOnSuggestionId String?
  /// [{ promptId, criterionCode, points }]
  criterionPoints     Json
  totalPoints         Float
  maxPoints           Float
  /// round(totalPoints / maxPoints * 100), the same 0-100 scale as TEST.
  score               Int
  feedback            String?
  resourceVersion     Int
  createdAt           DateTime             @default(now())

  @@index([submissionId, createdAt])
}

/// TAI-03 (TAI3-T4): immutable result of one subsim@1 run over one written assignment.
model SubmissionSimilarityRun {
  id               String                      @id @default(cuid())
  assignmentId     String
  assignment       Assignment                  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  actorId          String
  algorithmVersion String
  /// sha256 of the sorted "submissionId:resourceVersion" lines of the current submissions.
  inputDigest      String
  submissionCount  Int
  /// [{ submissionId, promptId, reason: "SHORT_RESPONSE" }]
  skipped          Json
  createdAt        DateTime                    @default(now())
  matches          SubmissionSimilarityMatch[]

  @@unique([assignmentId, algorithmVersion, inputDigest])
  @@index([assignmentId, createdAt])
}

model SubmissionSimilarityMatch {
  id             String                  @id @default(cuid())
  runId          String
  run            SubmissionSimilarityRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Lexicographically smaller submission id.
  submissionAId  String
  submissionA    AssignmentSubmission    @relation("SimilarityMatchA", fields: [submissionAId], references: [id], onDelete: Cascade)
  submissionBId  String
  submissionB    AssignmentSubmission    @relation("SimilarityMatchB", fields: [submissionBId], references: [id], onDelete: Cascade)
  /// "HIGH" | "ELEVATED"
  level          String
  maxContainment Float
  /// [{ promptId, containment, shared, level, spansA[], spansB[] }]
  perPrompt      Json
  reviews        SimilarityMatchReview[]

  @@unique([runId, submissionAId, submissionBId])
  @@index([submissionAId])
  @@index([submissionBId])
}

/// Append-only teacher review of one match; the newest row is current. The note is teacher-only.
model SimilarityMatchReview {
  id        String                    @id @default(cuid())
  matchId   String
  match     SubmissionSimilarityMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  actorId   String
  /// "NOTED" | "DISMISSED"
  status    String
  note      String?
  createdAt DateTime                  @default(now())

  @@index([matchId, createdAt])
}

/// Owning teacher's decision on one late submission (I3 / 3.3): REJECT_ZERO, or
/// REVISE_DEADLINE_FOR_CLASS written for every pending submission when the deadline is revised.
model LateDecision {
  id                 String                      @id @default(cuid())
  submissionId       String                      @unique
  submission         AssignmentSubmission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  decision           String
  actorId            String
  note               String?
  deadlineRevisionId String?
  deadlineRevision   AssignmentDeadlineRevision? @relation(fields: [deadlineRevisionId], references: [id])
  createdAt          DateTime                    @default(now())

  @@index([deadlineRevisionId])
}

model TeacherGateOverride {
  id           String    @id @default(cuid())
  studentId    String
  assignmentId String
  stepId       String
  actorId      String
  reason       String
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?

  @@unique([studentId, assignmentId, stepId])
  @@index([assignmentId, studentId, revokedAt])
  @@index([stepId])
}

/// Emergency block for new runs and submissions using a pack version.
model LabPackRevocation {
  packVersionId String   @id
  labId         String
  reason        String
  revokedById   String
  revokedAt     DateTime @default(now())

  @@index([labId])
}

/// Server-created, immutable launch tuple. Revocation never deletes historical evidence.
model LabRun {
  id               String         @id @default(cuid())
  studentId        String
  labId            String
  challengeId      String
  assignmentId     String?
  resourceId       String?
  resource         ClassResource? @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  classLabSnapshot Json?
  context          String
  execution        Json
  executionDigest  String
  createdAt        DateTime       @default(now())
  expiresAt        DateTime?
  revokedAt        DateTime?
  revokedById      String?
  revocationReason String?
  attempts         Attempt[]
  hints            HintLog[]
  events           LabRunEvent[]

  @@index([studentId, createdAt])
  @@index([labId, revokedAt])
  @@index([resourceId])
}

/// Ordered server evidence for activities that require a prediction before observation.
model LabRunEvent {
  id             String   @id @default(cuid())
  runId          String
  run            LabRun   @relation(fields: [runId], references: [id], onDelete: Restrict)
  sequence       Int
  idempotencyKey String
  event          Json
  createdAt      DateTime @default(now())

  @@unique([runId, sequence])
  @@unique([runId, idempotencyKey])
}

model Attempt {
  id                     String    @id @default(cuid())
  studentId              String
  student                User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  challengeId            String
  challenge              Challenge @relation(fields: [challengeId], references: [id])
  assignmentId           String?
  lessonStepId           String?
  labState               Json
  simulationResult       Json
  verdict                String
  durationMs             Int
  simulationModelVersion String    @default("1.0.0")
  /// Simulation configuration version evaluated for this attempt (C2-T3); null before C2.
  configVersionId        String?
  /// Topic simulation pack version active when the attempt was evaluated (CF-T4); null for earlier attempts.
  packVersionId          String?
  idempotencyKey         String?
  labRunId               String?
  labRun                 LabRun?   @relation(fields: [labRunId], references: [id], onDelete: Restrict)
  createdAt              DateTime  @default(now())
  hints                  HintLog[]

  @@unique([studentId, idempotencyKey])
  @@index([studentId, challengeId, createdAt])
  @@index([studentId, lessonStepId, createdAt])
  @@index([studentId, createdAt, id])
  @@index([labRunId])
  @@index([challengeId])
}

model HintLog {
  id              String      @id @default(cuid())
  /// Null for an in-run hint asked before the run was submitted (SAI-01A moments A and B).
  attemptId       String?
  attempt         Attempt?    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// The LabRun the hint belongs to; set for every checkpoint hint.
  labRunId        String?
  labRun          LabRun?     @relation(fields: [labRunId], references: [id], onDelete: Cascade)
  /// SAI-03A: a hint on one question of a lesson quiz step; set together with studentId.
  lessonStepId    String?
  lessonStep      LessonStep? @relation(fields: [lessonStepId], references: [id], onDelete: Cascade)
  studentId       String?
  student         User?       @relation("lessonHintStudent", fields: [studentId], references: [id], onDelete: Cascade)
  level           Int
  content         String
  contextSnapshot Json
  triggeredBy     String      @default("student")
  createdAt       DateTime    @default(now())
  /// SAI-01 provenance (legacy Lab hints). Null on older rows; readers treat a null ruleVersion as legacy.
  contextDigest   String?
  labDigest       String?
  ruleVersion     String?
  promptVersion   String?
  /// rules | rules-fallback | anthropic | fake | cache
  provider        String?
  model           String?
  fallbackReason  String?
  escalated       Boolean?
  variant         String?

  @@unique([attemptId, level])
  @@index([labRunId, createdAt])
  @@index([studentId, lessonStepId, createdAt])
  @@index([lessonStepId])
  @@index([createdAt])
}

/// SAI-01: validated provider observations only. No student data in key or value.
model HintObservationCache {
  key           String   @id
  observation   String
  promptVersion String
  model         String
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
}

model Progress {
  studentId     String
  student       User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentId     String
  status        String
  attemptsCount Int      @default(0)
  lastHintLevel Int      @default(0)
  score         Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@id([studentId, contentId])
}

model SavedExperiment {
  id               String   @id @default(cuid())
  studentId        String
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  labId            String
  labState         Json
  simulationResult Json
  note             String
  createdAt        DateTime @default(now())

  @@index([studentId])
}

/// Immutable simulation configuration for one lab (C2-T3). Activating a version
/// affects future attempts only; attempts pin the version they were evaluated with.
model SimulationConfigVersion {
  id              String    @id @default(cuid())
  labId           String
  version         Int
  /// Allowlisted model reference, e.g. circuit@1.0.0.
  modelRef        String
  /// Per base challenge: allowlisted parameters, validated against the model's ranges.
  challengeParams Json
  /// Golden cases verified by the server engine before the version is stored.
  goldenCases     Json
  /// draft | active | retired
  status          String    @default("draft")
  reason          String
  createdById     String
  createdAt       DateTime  @default(now())
  activatedAt     DateTime?
  retiredAt       DateTime?

  @@unique([labId, version])
  @@index([labId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  targetType String
  targetId   String?
  /// success | denied | failure
  outcome    String
  reason     String?
  /// Allowlisted, redacted field diff only; never a full object snapshot.
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model IdempotencyRecord {
  actorId     String
  key         String
  scope       String
  requestHash String
  statusCode  Int      @default(201)
  response    Json?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@id([actorId, key])
  @@index([expiresAt])
}

/// Shared expiring limiter store; `key` is a sha256 digest, never a raw IP or username.
model RateLimitBucket {
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?
  expiresAt   DateTime

  @@index([expiresAt])
}

/// Logical media item (CF-T2). Binary bytes live only in object storage; every change is a new immutable AssetVersion.
model Asset {
  id               String         @id @default(cuid())
  /// TEACHER_PRIVATE | SHARED_LIBRARY
  scope            String         @default("TEACHER_PRIVATE")
  /// Owning teacher/admin; null only for shared assets owned by the platform.
  ownerId          String?
  title            String
  /// pdf | image | video | caption | model
  kind             String
  /// ACTIVE | QUARANTINED | ARCHIVED
  status           String         @default("ACTIVE")
  license          String?
  source           String?
  attribution      String?
  quarantinedAt    DateTime?
  quarantineReason String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  versions         AssetVersion[]

  @@index([ownerId])
  @@index([status, scope])
}

/// Immutable stored object. Content and published lessons pin a READY version; replacement creates a new version and key.
model AssetVersion {
  id             String         @id @default(cuid())
  assetId        String
  asset          Asset          @relation(fields: [assetId], references: [id])
  version        Int
  /// PENDING | READY | FAILED | QUARANTINED
  status         String         @default("PENDING")
  /// r2 | local
  storage        String
  bucket         String
  /// Upload target; removed after finalize.
  stagingKey     String?
  /// Released object key; set only once READY and never rewritten.
  objectKey      String?        @unique
  fileName       String
  mime           String
  declaredBytes  Int
  bytes          Int?
  /// Server-computed full-object SHA-256 (never the multipart ETag).
  sha256         String?
  /// Optional client claim, compared with the server value.
  expectedSha256 String?
  etag           String?
  uploadId       String?
  multipart      Boolean        @default(false)
  validation     Json?
  failureReason  String?
  /// Pending uploads not finalized by then are aborted and cleaned up.
  expiresAt      DateTime?
  createdById    String
  createdAt      DateTime       @default(now())
  readyAt        DateTime?
  ebookCovers    EbookEdition[]

  @@unique([assetId, version])
  @@index([status, expiresAt])
}

/// Allowlisted source policy (CF-T3). Stores policy, never lessons; every change is a new SourcePolicyVersion.
model SourcePolicy {
  key            String                @id
  title          String
  enabled        Boolean               @default(false)
  currentVersion Int
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt
  versions       SourcePolicyVersion[]
}

model SourcePolicyVersion {
  id          String       @id @default(cuid())
  key         String
  source      SourcePolicy @relation(fields: [key], references: [key])
  version     Int
  /// accessMode, allowedHosts/paths/mime, maxBytes, licenseRule, storagePolicy, parser, rateLimitPerMinute, review dates.
  policy      Json
  reason      String
  createdById String?
  createdAt   DateTime     @default(now())

  @@unique([key, version])
}

/// One bounded ingestion pass; pins the exact policy version and parser.
model IngestionRun {
  id              String          @id @default(cuid())
  sourceKey       String
  policyVersionId String
  connector       String
  parserVersion   String
  trigger         String
  /// RUNNING | COMPLETED | FAILED
  status          String          @default("RUNNING")
  counts          Json?
  error           String?
  startedById     String?
  startedAt       DateTime        @default(now())
  finishedAt      DateTime?
  items           IngestionItem[]

  @@index([sourceKey, startedAt])
}

/// Staging state of one candidate; never learning content and never auto-published.
model IngestionItem {
  id                String       @id @default(cuid())
  runId             String
  run               IngestionRun @relation(fields: [runId], references: [id])
  externalId        String
  url               String?
  /// STAGED | DUPLICATE | REJECTED | NEEDS_REVIEW
  status            String
  rejection         String?
  sha256            String?
  artifactVersionId String?
  createdAt         DateTime     @default(now())

  @@index([runId])
}

model SourceArtifact {
  id         String                  @id @default(cuid())
  sourceKey  String
  externalId String
  title      String?
  createdAt  DateTime                @default(now())
  versions   SourceArtifactVersion[]

  @@unique([sourceKey, externalId])
}

/// Snapshot of an external item: locator, checksum, license snapshot; raw bytes only when the policy allows storing them.
model SourceArtifactVersion {
  id              String         @id @default(cuid())
  artifactId      String
  artifact        SourceArtifact @relation(fields: [artifactId], references: [id])
  version         Int
  canonicalUrl    String
  retrievedAt     DateTime
  sha256          String
  mime            String
  bytes           Int
  licenseSnapshot Json
  locator         String?
  parserVersion   String?
  /// METADATA_ONLY | SNAPSHOT
  storagePolicy   String
  rawObjectKey    String?
  normalized      Json?
  /// STAGED | METADATA_VERIFIED | REJECTED
  reviewStatus    String         @default("STAGED")
  createdAt       DateTime       @default(now())

  @@unique([artifactId, version])
  @@unique([artifactId, sha256])
}

/// Curriculum-aligned content pack (CF-T1). `namespace` fixture packs never reach pilot/production.
model ContentPack {
  key       String               @id
  grade     Int
  domain    String
  title     String
  /// fixture | baseline
  namespace String
  createdAt DateTime             @default(now())
  versions  ContentPackVersion[]
}

/// Immutable pack version; a release materializes it as a shared-library lesson.
model ContentPackVersion {
  id                  String      @id @default(cuid())
  packKey             String
  pack                ContentPack @relation(fields: [packKey], references: [key])
  version             Int
  /// sha256 of the canonical manifest
  digest              String
  manifest            Json
  /// released | retired
  status              String
  synthetic           Boolean     @default(false)
  outcomeCodes        Json        @default("[]")
  lessonId            String?
  releaseId           String?
  createdAt           DateTime    @default(now())
  releasedAt          DateTime?
  retiredAt           DateTime?
  materializedLessons Lesson[]

  @@unique([packKey, version])
  @@unique([packKey, digest])
}

/// Deployment record of one approved content manifest in one environment.
model ContentRelease {
  id              String               @id @default(cuid())
  environment     String
  name            String
  digest          String
  importerVersion String
  /// APPLIED | RETIRED
  status          String
  initiatedById   String
  approvedById    String
  summary         Json
  createdAt       DateTime             @default(now())
  retiredAt       DateTime?
  items           ContentReleaseItem[]

  @@unique([environment, digest])
}

model ContentReleaseItem {
  id        String         @id @default(cuid())
  releaseId String
  release   ContentRelease @relation(fields: [releaseId], references: [id])
  /// source-policy | pack-version | lesson
  kind      String
  refId     String
  /// created | unchanged | superseded
  action    String
  createdAt DateTime       @default(now())

  @@index([releaseId])
}

/// Immutable reviewed practical activity (CF-T4); a simulation pack cannot exist without one.
model PracticalActivityVersion {
  id          String   @id @default(cuid())
  key         String
  version     Int
  digest      String
  /// objective, materials, setup, procedure, variables, observations, expectedResult, explanation, safety, limitations, modality, outcomeCodes, sources
  spec        Json
  /// named subject/safety reviews
  reviews     Json
  createdById String
  createdAt   DateTime @default(now())

  @@unique([key, version])
  @@unique([key, digest])
}

/// Immutable topic simulation pack version (CF-T4): pins model, template, visual asset, semantic map, bindings and challenge templates.
model SimulationPackVersion {
  id                   String    @id @default(cuid())
  key                  String
  version              Int
  labId                String
  modelRef             String
  engineVersion        String
  activityVersionId    String
  /// units, ranges, initialState, limitations, goldenCases
  template             Json
  visualAssetVersionId String?
  semanticMap          Json
  bindings             Json
  challengeTemplates   Json
  reviews              Json
  /// draft | active | retired
  status               String    @default("draft")
  validation           Json?
  reason               String
  createdById          String
  createdAt            DateTime  @default(now())
  activatedAt          DateTime?
  retiredAt            DateTime?

  @@unique([key, version])
  @@index([labId, status])
}

/// In-app notification (acc-3, D-ACC-02): written in the same transaction as its domain event,
/// or synced on read for time-based notices (due soon, overdue). dedupKey makes writers idempotent.
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String?
  link        String?
  dedupKey    String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([recipientId, dedupKey])
  @@index([recipientId, readAt, createdAt])
}

/// SAI-02A (UC-AI-07): the class teacher disagrees with a misconception hypothesis on one step of a Lab
/// assignment. Feedback on the rule only: it never changes a verdict, a hint or what students see.
model HintInsightDisagreement {
  id            String     @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  teacherId     String
  rubricRef     String
  criterion     String
  misconception String
  /// Misconception rule version the teacher disagreed with (e.g. checkpoint-misconceptions@1).
  ruleVersion   String
  note          String?
  createdAt     DateTime   @default(now())

  @@unique([assignmentId, rubricRef, criterion, misconception])
  @@index([teacherId])
}

/// SAI-04: one tutoring conversation of a student inside a Lab or a lesson. Never shown to parents (BR-11).
model TutorConversation {
  id          String         @id @default(cuid())
  studentId   String
  student     User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// LAB | LESSON | EBOOK (B5: contextId is the subject whose textbook is read)
  contextKind String
  contextId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    TutorMessage[]

  @@index([studentId, contextKind, contextId, createdAt])
}

/// SAI-04: one turn. STUDENT rows keep the typed text; TUTOR rows keep the reply and its provenance (BR-13).
model TutorMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  studentId      String
  student        User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// STUDENT | TUTOR
  role           String
  content        String
  /// B5: the textbook passage the student highlighted (STUDENT rows of EBOOK conversations).
  passage        String?           @db.Text
  pageNumber     Int?
  /// ANSWERED | REFUSED | DISABLED | FALLBACK (TUTOR rows only)
  outcome        String?
  /// Why a turn was refused or fell back: INJECTION, UNSAFE_TOPIC, PERSONAL_DATA, ANSWER_SEEKING, OFF_TOPIC, GUARD:<rule>, BUDGET, ...
  reason         String?
  ruleVersion    String?
  promptVersion  String?
  provider       String?
  model          String?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@index([studentId, createdAt])
}

// ---------------------------------------------------------------------------
// Teacher AI job runtime (TAI-01, spec-teacher-ai-authoring). Shared by every Teacher AI purpose; later specs only add
// expand-only nullable columns. AI output never writes ClassResource directly: items become a DRAFT only through an
// owner materialization (TAI-T4).
enum AiJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AiItemDecisionKind {
  ACCEPTED
  EDITED
  REJECTED
}

model AiJob {
  id                     String                  @id @default(cuid())
  classId                String
  actorId                String
  /// "GENERATE_RESOURCE" in TAI-01, "ASSESS_SUBMISSION" (TAI-02), "DRAFT_LAB_CHALLENGE" (TAI-06); quota is counted per actor and purpose.
  purpose                String
  /// Resource kind of a GENERATE_RESOURCE job; null for purposes that do not create a class resource (TAI-06).
  targetKind             ClassResourceKind?
  lessonId               String
  /// Normalized request body (instruction included). Written once at creation.
  request                Json
  /// Passages and outcome statements actually sent. Written once at creation.
  inputSnapshot          Json
  /// sha256 of stableStringify(inputSnapshot).
  inputDigest            String
  promptVersion          String
  outputSchemaVersion    String
  /// "gemini" | "fake"
  provider               String
  model                  String
  status                 AiJobStatus             @default(PENDING)
  failureCode            String?
  attemptCount           Int                     @default(0)
  leaseUntil             DateTime?
  inputTokens            Int?
  outputTokens           Int?
  /// [{ position, reasonCodes[] }]
  droppedItems           Json                    @default("[]")
  materializedResourceId String?                 @unique
  /// TAI-06: the lesson a DRAFT_LAB_CHALLENGE proposal was applied to, and the one applied item (one apply per job).
  appliedLessonId        String?
  appliedItemId          String?                 @unique
  /// TAI-02 (TAI2-T4): set only for purpose ASSESS_SUBMISSION; cascade so the redacted snapshot dies with the submission.
  submissionId           String?
  submission             AssignmentSubmission?   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt              DateTime                @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  /// TAI-05: credit columns, null for a job created while AI_CREDITS_ENABLED=false. A job with estimatedCredits set is
  /// always settled or refunded in its terminal transition, whatever the flag says later.
  pricingVersionId       String?
  estimatedCredits       Int?
  chargedCredits         Int?
  items                  AiJobItem[]
  suggestion             AiAssessmentSuggestion?

  @@index([actorId, purpose, createdAt])
  @@index([status, leaseUntil])
  @@index([classId, createdAt])
  @@index([submissionId, promptVersion])
}

/// TAI-02 (TAI2-T4): verification outcome of one assessment suggestion.
enum AiSuggestionStatus {
  VALID
  PARTIAL
  SUPPRESSED
}

/// TAI-02 (TAI2-T4): immutable AI rubric suggestion produced by one ASSESS_SUBMISSION job. Teacher-only; never part of
/// a student, parent, rollup or notification read model. In shadow mode only the evaluation report reads it.
model AiAssessmentSuggestion {
  id               String               @id @default(cuid())
  jobId            String               @unique
  job              AiJob                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  submissionId     String
  submission       AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  resourceVersion  Int
  promptVersion    String
  /// "shadow" | "assist": AI_ASSESSMENT_MODE when the job was created.
  mode             String
  status           AiSuggestionStatus
  /// [{ promptId, criterionCode, valid, reasonCode, suggestedPoints, rationale, uncertainty, evidence[{ quote, start, end }], returnedQuotes, verifiedQuotes }]
  criterionResults Json
  /// e.g. ["INJECTION_SUSPECTED"]
  flags            Json                 @default("[]")
  createdAt        DateTime             @default(now())

  @@index([submissionId, createdAt])
  @@index([promptVersion, mode])
}

/// Immutable validated item, written in the transaction that moves its job to SUCCEEDED.
model AiJobItem {
  id        String           @id @default(cuid())
  jobId     String
  job       AiJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  position  Int
  /// Item per the output schema, sourceRefs included.
  payload   Json
  /// Warning codes (validation-rules.md).
  flags     Json             @default("[]")
  createdAt DateTime         @default(now())
  decisions AiItemDecision[]

  @@unique([jobId, position])
}

/// Append-only; the latest row per item is the current decision.
model AiItemDecision {
  id            String             @id @default(cuid())
  itemId        String
  item          AiJobItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actorId       String
  decision      AiItemDecisionKind
  /// Required for EDITED, forbidden otherwise.
  editedPayload Json?
  /// Required for REJECTED.
  reasonCode    String?
  createdAt     DateTime           @default(now())

  @@index([itemId, createdAt])
}

/// TAI-03 Part A (qdup@1): one row per live question/card of a class resource or a released shared-library lesson.
/// Rebuilt inside the transaction of every change of its source; never edited by hand.
model QuestionFingerprint {
  id             String   @id @default(cuid())
  /// "CLASS_RESOURCE" | "LIBRARY_LESSON"
  sourceKind     String
  /// ClassResource.id or Lesson.id
  sourceId       String
  /// Resource version; 1 for lessons (rebuilt on every lesson change)
  sourceVersion  Int
  /// Question/card id inside the source; "<stepId>:<questionId>" for lessons
  itemId         String
  /// Class owner (Classroom.teacherId); null for library rows
  ownerTeacherId String?
  classId        String?
  normalizedText String
  normalizedHash String
  /// "qdup@1"
  algorithm      String
  createdAt      DateTime @default(now())

  @@unique([sourceKind, sourceId, sourceVersion, itemId, algorithm])
  @@index([ownerTeacherId, normalizedHash])
  @@index([sourceKind, normalizedHash])
}

enum InsightAckAction {
  ACKNOWLEDGED
  DISMISSED
}

/// TAI-04 (TAI4-T3): append-only teacher response to one insight fingerprint. Insights themselves are never stored.
/// The latest row per fingerprint is current; rows are never updated or deleted by the application.
model InsightAcknowledgement {
  id          String           @id @default(cuid())
  classId     String
  classroom   Classroom        @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId   String
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fingerprint String
  ruleVersion String
  ruleCode    String
  /// Sorted evidence ids, kept for replay.
  evidenceIds Json
  action      InsightAckAction
  /// At most 500 characters, teacher-only, never audited.
  note        String?
  actorId     String
  createdAt   DateTime         @default(now())

  @@index([classId, studentId, createdAt])
  @@index([fingerprint, createdAt])
}

/// TAI-05: ledger account kinds. Teacher accounts are per teacher, system accounts are singletons (ownerId null).
enum CreditAccountKind {
  TEACHER_AVAILABLE
  TEACHER_RESERVED
  SYSTEM_ISSUANCE
  SYSTEM_CONSUMED
}

enum CreditTxKind {
  GRANT
  ADJUST
  RESERVE
  SETTLE
  REFUND
}

/// TAI-05: `balance` is a cached projection of the entries, updated in the posting transaction. A DB CHECK (migration)
/// keeps teacher accounts >= 0, and a partial unique index (migration) keeps each system account a singleton.
model CreditAccount {
  id        String            @id @default(cuid())
  kind      CreditAccountKind
  ownerId   String?
  balance   Int               @default(0)
  createdAt DateTime          @default(now())
  entries   CreditEntry[]

  @@unique([kind, ownerId])
}

/// TAI-05: immutable header of one posting. No route or code path updates or deletes it.
model CreditTransaction {
  id               String        @id @default(cuid())
  kind             CreditTxKind
  aiJobId          String?
  pricingVersionId String?
  /// Admin for GRANT/ADJUST, teacher for RESERVE, null (system) for SETTLE/REFUND.
  actorId          String?
  /// Required for GRANT/ADJUST.
  reason           String?
  idempotencyKey   String?
  createdAt        DateTime      @default(now())
  entries          CreditEntry[]

  @@unique([aiJobId, kind])
  @@unique([actorId, idempotencyKey])
  @@index([createdAt])
}

/// TAI-05: immutable signed amount; the entries of one transaction sum to zero.
model CreditEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   CreditTransaction @relation(fields: [transactionId], references: [id])
  accountId     String
  account       CreditAccount     @relation(fields: [accountId], references: [id])
  amount        Int

  @@index([accountId])
  @@index([transactionId])
}

/// TAI-05: versioned price of one AI purpose. A job pins the version used at reserve. Active rows are never edited.
model PricingVersion {
  id                       String    @id @default(cuid())
  purpose                  String
  version                  Int
  baseCredits              Int
  perItemCredits           Int
  creditsPer1kInputTokens  Int
  creditsPer1kOutputTokens Int
  /// Path to the pricing evidence note.
  evidenceRef              String
  /// draft | active | retired
  status                   String    @default("draft")
  createdById              String
  createdAt                DateTime  @default(now())
  activatedAt              DateTime?
  retiredAt                DateTime?

  @@unique([purpose, version])
}
