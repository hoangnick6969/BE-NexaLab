generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}
enum LessonStepType {
  READING
  VIDEO
  STUDY_CARDS
  QUIZ
  LAB
  CHALLENGE
}
enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}
enum EnrollmentStatus {
  pending
  approved
  removed
}
enum StepProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
model User {
  id String @id @default(cuid())
  username String? @unique
  email String? @unique
  passwordHash String
  fullName String
  role Role
  grade Int @default(8)
  studentLevel String @default("beginner")
  status String @default("active")
  mustChangePassword Boolean @default(false)
  temporaryPasswordExpiresAt DateTime?
  consentAt DateTime?
  linkCode String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  attempts Attempt[]
  enrollments Enrollment[]
  classes Classroom[]
  lessons Lesson[]
  progress Progress[]
  stepProgress StepProgress[]
  quizAttempts QuizAttempt[]
  saved SavedExperiment[]
  parents ParentLink[] @relation("student")
  children ParentLink[] @relation("parent")
  assignmentTargets AssignmentTarget[]
}
model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  kind String @default("refresh")
  expiresAt DateTime
}
model ParentLink {
  parentId String
  studentId String
  parent User @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("student", fields: [studentId], references: [id], onDelete: Cascade)
  verifiedAt DateTime @default(now())
  @@id([parentId, studentId])
}
model Classroom {
  id String @id @default(cuid())
  teacherId String
  teacher User @relation(fields: [teacherId], references: [id])
  name String
  grade Int @default(8)
  /// Legacy Increment A code; no longer accepted for joining (B1-T3).
  joinCode String? @unique
  status ClassroomStatus @default(ACTIVE)
  archivedAt DateTime?
  joinCodeEnabled Boolean @default(true)
  requiresApproval Boolean @default(false)
  /// Opaque 6-character Crockford Base32 locator; the secret is stored only as an HMAC.
  joinLocator String? @unique
  joinSecretHash String?
  joinKeyVersion Int?
  joinCodeRotatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  enrollments Enrollment[]
  assignments Assignment[]
  @@index([teacherId, status])
}
model Enrollment {
  classId String
  studentId String
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status EnrollmentStatus @default(pending)
  /// Deprecated mirror of `status = approved`, kept in sync until the contract migration.
  approved Boolean @default(false)
  joinedAt DateTime @default(now())
  statusChangedAt DateTime @default(now())
  @@id([classId, studentId])
  @@index([studentId, status])
}
model Subject {
  id String @id
  name String
  lessons Lesson[]
  labs Lab[]
}
model Lesson {
  id String @id @default(cuid())
  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id])
  authorId String
  author User @relation(fields: [authorId], references: [id])
  title String
  chapter String
  grade Int
  topic String
  learningObjective String
  prerequisites String
  curriculum String
  content String
  labId String?
  status String @default("draft")
  materials Json @default("[]")
  questions Json @default("[]")
  /// TEACHER_PRIVATE (owner-only edit, self-review) or SHARED_LIBRARY (admin-managed baseline).
  scope String @default("TEACHER_PRIVATE")
  /// Synthetic development/E2E fixture; never presented as released corpus.
  synthetic Boolean @default(false)
  clonedFromId String?
  /// Allowlisted self-review attestation required to publish teacher-private content.
  review Json?
  /// KHTN content strand (MATTER | ENERGY | LIVING | EARTH_SKY).
  domain String?
  /// CurriculumOutcome codes this lesson addresses.
  outcomeCodes Json @default("[]")
  /// Teacher-chosen challenge parameters, validated against the model's allowed ranges.
  challengeParams Json?
  /// Named shared-library release reviews: { kind: { reviewerId, at, note? } }.
  releaseReview Json?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  steps LessonStep[]
  @@index([scope, status, grade])
  @@index([authorId, status])
}
/// Grade 8–9 KHTN outcome map (Content Foundation). `synthetic` rows are dev fixtures and never count as released coverage.
model CurriculumOutcome {
  code String @id
  grade Int
  domain String
  chapter String
  statement String
  synthetic Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([grade, domain])
}
model LessonStep {
  id String @id @default(cuid())
  lessonId String
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type LessonStepType
  position Int
  required Boolean @default(true)
  config Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  progress StepProgress[]
  @@unique([lessonId, position])
  @@index([lessonId, type])
}
model StepProgress {
  studentId String
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stepId String
  step LessonStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  status StepProgressStatus @default(NOT_STARTED)
  progressValue Int @default(0)
  lastPosition Int?
  visitedCardIds Json @default("[]")
  startedAt DateTime?
  completedAt DateTime?
  updatedAt DateTime @updatedAt
  @@id([studentId, stepId])
  @@index([stepId])
}
model QuizAttempt {
  id String @id @default(cuid())
  studentId String
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId String
  stepId String
  assignmentId String?
  answers Json
  questionSnapshot Json
  correctCount Int
  questionCount Int
  score Float
  passed Boolean
  idempotencyKey String
  createdAt DateTime @default(now())
  @@unique([studentId, idempotencyKey])
  @@index([studentId, lessonId, createdAt])
  @@index([lessonId, stepId, passed])
  @@index([studentId, createdAt, id])
}
model Lab {
  id String @id
  subjectId String
  subject Subject @relation(fields: [subjectId], references: [id])
  title String
  grade Int @default(8)
  topic String
  learningObjective String
  status String @default("published")
  simulationModelRef String
  config Json @default("{}")
  assets Json @default("[]")
  challenges Challenge[]
}
model Challenge {
  id String @id
  labId String
  lab Lab @relation(fields: [labId], references: [id])
  objective String
  constraints Json
  difficulty String @default("intermediate")
  attempts Attempt[]
}
model Assignment {
  id String @id @default(cuid())
  classId String
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  contentId String
  contentType String
  title String
  dueDate DateTime?
  /// Deprecated mirror of the target snapshot; AssignmentTarget is authoritative.
  studentIds Json @default("[]")
  /// CLASS (approved members at creation) or SUBSET (selected approved members).
  audience String @default("CLASS")
  /// sha256 of the sorted target student IDs, used by the active-duplicate rule.
  targetHash String?
  /// Immutable content version at assignment time (lesson structure or lab model/config hash).
  contentVersion String?
  status String @default("ACTIVE")
  createdById String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  targets AssignmentTarget[]
  @@index([classId, status, dueDate])
  @@index([contentType, contentId, status])
}
model AssignmentTarget {
  assignmentId String
  studentId String
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([assignmentId, studentId])
  @@index([studentId])
}
model Attempt {
  id String @id @default(cuid())
  studentId String
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  challengeId String
  challenge Challenge @relation(fields: [challengeId], references: [id])
  assignmentId String?
  lessonStepId String?
  labState Json
  simulationResult Json
  verdict String
  durationMs Int
  simulationModelVersion String @default("1.0.0")
  idempotencyKey String?
  createdAt DateTime @default(now())
  hints HintLog[]
  @@unique([studentId, idempotencyKey])
  @@index([studentId, challengeId, createdAt])
  @@index([studentId, lessonStepId, createdAt])
  @@index([studentId, createdAt, id])
}
model HintLog {
  id String @id @default(cuid())
  attemptId String
  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  level Int
  content String
  contextSnapshot Json
  triggeredBy String @default("student")
  createdAt DateTime @default(now())
  @@unique([attemptId, level])
}
model Progress {
  studentId String
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentId String
  status String
  attemptsCount Int @default(0)
  lastHintLevel Int @default(0)
  score Float @default(0)
  updatedAt DateTime @updatedAt
  @@id([studentId, contentId])
}
model SavedExperiment {
  id String @id @default(cuid())
  studentId String
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
  labId String
  labState Json
  simulationResult Json
  note String
  createdAt DateTime @default(now())
}
model AssetFile {
  id String @id
  ownerId String
  name String
  mime String
  size Int
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actorRole String?
  action String
  targetType String
  targetId String?
  /// success | denied | failure
  outcome String
  reason String?
  /// Allowlisted, redacted field diff only; never a full object snapshot.
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
model IdempotencyRecord {
  actorId String
  key String
  scope String
  requestHash String
  statusCode Int @default(201)
  response Json?
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@id([actorId, key])
  @@index([expiresAt])
}
/// Shared expiring limiter store; `key` is a sha256 digest, never a raw IP or username.
model RateLimitBucket {
  key String @id
  count Int @default(0)
  windowStart DateTime
  lockedUntil DateTime?
  expiresAt DateTime
  @@index([expiresAt])
}
