# Copy actual host/user from Supabase Connect; percent-encode the password.
# Long-lived API: Session pooler, SSL required. Never expose these as VITE_*.
DATABASE_URL=postgresql://USER:PASSWORD@SESSION_HOST:5432/postgres?sslmode=require&connection_limit=1
# The API talks to PostgreSQL through the node-postgres driver adapter (one round trip per query;
# works with the transaction pooler on 6543, query params such as pgbouncer=true are ignored).
# TLS to a remote host is verified: *.supabase.com uses certs/supabase-root-2021.crt, any other host
# needs DATABASE_SSL_CA_FILE or falls back to the Prisma engine. DATABASE_DRIVER=engine forces the engine.
# DATABASE_SSL_CA_FILE=
# DATABASE_DRIVER=
# Migrations and seed: direct SSL; use copied Session URI if IPv6 is unreachable.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require
APP_ENV=development
# Empty keeps curriculum sync local-only. Add only a dedicated remote development project ref.
CURRICULUM_REMOTE_DEVELOPMENT_PROJECT_REFS=
# Explicitly match DIRECT_URL hostname/database; never seed pilot/staging/production.
SEED_TARGET=DIRECT_HOST/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=4100
WEB_ORIGIN=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=NexaLab <no-reply@nexalab.local>
SEED_PASSWORD=ReplaceDemoPassword123!
SEED_FIXTURE_PASSWORD=ReplaceFixturePassword123!
SEED_RESET_FIXTURES=false
SEED_TEACHER_OWNER_EMAIL=teacher.owner@nexalab.local
SEED_TEACHER_OUTSIDER_EMAIL=teacher.outsider@nexalab.local
SEED_STUDENT_TEMP_USERNAME=student.temp
SEED_STUDENT_ACTIVE_USERNAME=student.active
SEED_STUDENT_OUTSIDER_USERNAME=student.outsider

# Student AI (AD-18, spec-student-ai-llm). LLM-first wording, rules as plan and fallback; SAI-04 tutor chat.
# The switch is honoured only with APP_ENV=development|test while gate SG-2 is open (pilot/production stay rules-only).
# Only a provider tier that does not train on API data may ever be configured. STUDENT_AI_PROVIDER=fake (dev/test only)
# answers deterministically; STUDENT_AI_FAKE_REPLY overrides its raw reply for tests.
STUDENT_AI_LLM_ENABLED=false
STUDENT_AI_PROVIDER=anthropic
STUDENT_AI_HINTS_PER_10_MIN=8
STUDENT_AI_DAILY_PROVIDER_CALLS=60
STUDENT_AI_PROVIDER_TIMEOUT_MS=8000
STUDENT_AI_CACHE_TTL_DAYS=30
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Object storage (Content Foundation CF-T2). Backend only; never VITE_*. Run `npm run r2:check` after setting.
# Key layout, bucket CORS/lifecycle rules and the pilot/production bucket checklist: docs/operations/r2-storage.md
# ASSET_STORAGE=r2 uses Cloudflare R2; anything else uses the local driver (UPLOAD_DIR/objects, dev/test only).
ASSET_STORAGE=local
R2_ACCOUNT_ID=
R2_BUCKET=nexalab-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_UPLOAD_TTL_SECONDS=900
R2_READ_TTL_SECONDS=300
# Per-type upload budgets in MB (development proposal; pilot/production need ASSET_BUDGETS_APPROVED=true after Q-DATA-01/Q-C2-03).
ASSET_MAX_VIDEO_MB=300
ASSET_MAX_PDF_MB=20
ASSET_MAX_IMAGE_MB=10
ASSET_MAX_CAPTION_MB=1
ASSET_MAX_MODEL_MB=50
ASSET_BUDGETS_APPROVED=false
# Optional malware scanner endpoint; without it pilot/production uploads cannot become READY.
MALWARE_SCANNER_URL=
# Development/test only: lets source policies point at 127.0.0.1 fixtures (SSRF guard stays on otherwise).
ALLOW_PRIVATE_SOURCE_HOSTS=false
