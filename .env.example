# Copy actual host/user from Supabase Connect; percent-encode the password.
# Long-lived API: Session pooler, SSL required. Never expose these as VITE_*.
DATABASE_URL=postgresql://USER:PASSWORD@SESSION_HOST:5432/postgres?sslmode=require&connection_limit=1
# The API talks to PostgreSQL through the node-postgres driver adapter (one round trip per query;
# works with the transaction pooler on 6543, query params such as pgbouncer=true are ignored).
# TLS to a remote host is verified: *.supabase.com uses certs/supabase-root-2021.crt, any other host
# needs DATABASE_SSL_CA_FILE or falls back to the Prisma engine. DATABASE_DRIVER=engine forces the engine.
# DATABASE_SSL_CA_FILE=
# DATABASE_DRIVER=
# Migrations and seed: direct SSL; use copied Session URI if IPv6 is unreachable.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require
APP_ENV=development
# Empty keeps curriculum sync local-only. Add only a dedicated remote development project ref.
CURRICULUM_REMOTE_DEVELOPMENT_PROJECT_REFS=
# Explicitly match DIRECT_URL hostname/database; never seed pilot/staging/production.
SEED_TARGET=DIRECT_HOST/postgres
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=4100
WEB_ORIGIN=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=NexaLab <no-reply@nexalab.local>
SEED_PASSWORD=ReplaceDemoPassword123!
SEED_FIXTURE_PASSWORD=ReplaceFixturePassword123!
SEED_RESET_FIXTURES=false
SEED_TEACHER_OWNER_EMAIL=teacher.owner@nexalab.local
SEED_TEACHER_OUTSIDER_EMAIL=teacher.outsider@nexalab.local
SEED_STUDENT_TEMP_USERNAME=student.temp
SEED_STUDENT_ACTIVE_USERNAME=student.active
SEED_STUDENT_OUTSIDER_USERNAME=student.outsider

# Student AI (AD-18, spec-student-ai-llm). LLM-first wording, rules as plan and fallback; SAI-04 tutor chat.
# The switch is honoured only with APP_ENV=development|test while gate SG-2 is open (pilot/production stay rules-only).
# Only a provider tier that does not train on API data may ever be configured. STUDENT_AI_PROVIDER=fake (dev/test only)
# answers deterministically; STUDENT_AI_FAKE_REPLY overrides its raw reply for tests.
STUDENT_AI_LLM_ENABLED=false
# gemini (default) | anthropic | fake (dev/test only). Gemini API terms bar under-18 apps: SG-2 must close before shared use.
STUDENT_AI_PROVIDER=gemini
STUDENT_AI_HINTS_PER_10_MIN=8
STUDENT_AI_DAILY_PROVIDER_CALLS=60
STUDENT_AI_PROVIDER_TIMEOUT_MS=8000
STUDENT_AI_CACHE_TTL_DAYS=30
GEMINI_API_KEY=
# Exact Flash model id from Google AI Studio (no default in code)
GEMINI_MODEL=
# minimal (default) | low | medium | high — higher levels are slower than the 8 s provider timeout
GEMINI_THINKING_LEVEL=minimal
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Teacher AI (TAI-01). Empty AI_PROVIDER = not configured (job creation returns 503). `fake` is for local dev/tests and
# makes the API refuse to boot when APP_ENV or NODE_ENV is production. `gemini` is a planned adapter: no live call until
# gate G-6 (provider eligibility for the under-18 context, input boundaries, retention) is recorded. Backend only.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_RUNNER_ENABLED=true
AI_DAILY_JOB_LIMIT=20
AI_CONCURRENT_JOB_LIMIT=2
AI_PROVIDER_MIN_INTERVAL_MS=6000

# TAI-02 AI rubric suggestions (gate G-2). Off by default. AI_ASSESSMENT_ENABLED=true needs AI_ASSESSMENT_POLICY to name a
# recorded policy (src/config/ai-assessment.ts); `g2-pii-scrub@1` is the team-lead dev/test decision of 2026-11-09 (not
# PO, lecturer or legal approval): fake provider only, never production. Mode off|shadow|assist; assist also needs a
# recorded shadow-evaluation PASS for the active prompt version. Boot fails otherwise. Backend only.
AI_ASSESSMENT_ENABLED=false
AI_ASSESSMENT_MODE=off
AI_ASSESSMENT_POLICY=
AI_DAILY_ASSESSMENT_LIMIT=200

# TAI-05 AI credits (gate G-3). Off by default: with AI_CREDITS_ENABLED=false the AI job flows behave exactly as before.
# On: the create routes need `confirmedCredits`, every job reserves credits and settles or refunds at its terminal status.
# Prices are PricingVersion rows (admin routes, no code change). Boot seeds version 1 of a purpose with no row from the
# team-lead baseline of 2026-11-09 (not PO-approved, pending measured usage): _bmad-output/specs/spec-teacher-ai-credits/tai-05-pricing-evidence.md
# Override the baseline BEFORE the first seed with AI_CREDITS_<GENERATE_RESOURCE|ASSESS_SUBMISSION>_<BASE|PER_ITEM|IN_1K|OUT_1K>.
AI_CREDITS_ENABLED=false
AI_CREDITS_SEED_BASELINE=true
AI_CREDITS_EVIDENCE_REF=
# The DRAFT_LAB_CHALLENGE purpose (TAI-06) is also priced; its baseline override uses AI_CREDITS_DRAFT_LAB_CHALLENGE_<BASE|PER_ITEM|IN_1K|OUT_1K>.

# TAI-06 AI lab-challenge drafting: quota counted for this purpose only (never the GENERATE_RESOURCE quota).
# Parameter bounds are the team-lead defaults of 2026-11-09, pending PO/reviewer confirmation: _bmad-output/specs/spec-teacher-ai-lab-drafting/team-lead-default-bounds.md
AI_LAB_CHALLENGE_DAILY_LIMIT=10
AI_LAB_CHALLENGE_CONCURRENT_LIMIT=2

# Object storage (Content Foundation CF-T2). Backend only; never VITE_*. Run `npm run r2:check` after setting.
# Key layout, bucket CORS/lifecycle rules and the pilot/production bucket checklist: docs/operations/r2-storage.md
# ASSET_STORAGE=r2 uses Cloudflare R2; anything else uses the local driver (UPLOAD_DIR/objects, dev/test only).
ASSET_STORAGE=local
R2_ACCOUNT_ID=
R2_BUCKET=nexalab-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_UPLOAD_TTL_SECONDS=900
R2_READ_TTL_SECONDS=300
# Per-type upload budgets in MB (development proposal; pilot/production need ASSET_BUDGETS_APPROVED=true after Q-DATA-01/Q-C2-03).
ASSET_MAX_VIDEO_MB=300
ASSET_MAX_PDF_MB=20
ASSET_MAX_IMAGE_MB=10
ASSET_MAX_CAPTION_MB=1
ASSET_MAX_MODEL_MB=50
ASSET_BUDGETS_APPROVED=false
# Optional malware scanner endpoint; without it pilot/production uploads cannot become READY.
MALWARE_SCANNER_URL=
# Development/test only: lets source policies point at 127.0.0.1 fixtures (SSRF guard stays on otherwise).
ALLOW_PRIVATE_SOURCE_HOSTS=false

# Teacher insights (TAI-04). SUDDEN_UNAIDED_PASS stays hidden in the pilot (PO decision, gate G-5, 2026-11-06): the pattern
# is always computed and tested, and shown only when this is true. Any value other than true or false stops boot.
INSIGHTS_SHOW_SUDDEN_UNAIDED_PASS=false
